# PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/restaurant

# Сгенерируй уникальный секрет: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
