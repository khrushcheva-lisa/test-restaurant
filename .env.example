# PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/restaurant

# Сгенерируй уникальный секрет: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Данные администратора
ADMIN_LOGIN=admin
ADMIN_PASSWORD=MyStrongPassword123!

# Данные сотрудника
ADMIN_FIRST_NAME=Иван
ADMIN_LAST_NAME=Иванов
ADMIN_PATRONYMIC=Иванович
ADMIN_PHONE=+79991234567
ADMIN_EMAIL=admin@restaurant.ru
ADMIN_BIRTHDATE=1990-05-15
ADMIN_HIRE_DATE=2026-01-01